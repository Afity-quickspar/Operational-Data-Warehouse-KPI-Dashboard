# ============================================================================
# Example environment variables for a cloud warehouse target.
# Copy to `.env` (gitignored) and fill in real values — only needed if you're
# running dbt against Snowflake/BigQuery via
# dbt/warehouse_dbt/profiles.cloud.example.yml. Not required for the default
# local DuckDB pipeline (`python src/orchestrate.py`).
# ============================================================================

# --- Snowflake ---------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_WAREHOUSE=

# --- BigQuery ------------------------------------------------------------------
BIGQUERY_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
